# Antiview Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Optional: Set to MongoDB Atlas or local URI. If omitted or unreachable,
# Antiview automatically falls back to an embedded in-memory MongoDB in dev/demo mode.
MONGODB_URI=mongodb://localhost:27017/antiview

# Authentication Security
JWT_SECRET=antiview_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# Google Gemini API
# Optional for local demo (a high-fidelity fallback generator operates if empty)
# Provide your key from https://aistudio.google.com to enable real-time Gemini 3.8 Flash AI
GEMINI_API_KEY=
